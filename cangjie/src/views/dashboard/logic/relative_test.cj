package textura.views.dashboard.logic

/**
 * `relativeTime` 的期望值来自 Web 版依赖的 `date-fns@4`：
 *
 * `formatDistance(new Date(iso), new Date(now), { addSuffix: true, locale: zhCN })`
 * 在 `TZ=Asia/Shanghai` 下逐条跑出的结果（见 DASHBOARD-LOGIC.md「与 TS 的差异」）。
 */
const RELATIVE_NOW = "2026-01-05T12:00:00"

@Test
func relativeTimePastTest(): Unit {
    let cases = [
        ("2026-01-05T12:00:00", "不到 1 分钟前"),
        ("2026-01-05T11:59:31", "不到 1 分钟前"),
        ("2026-01-05T11:59:30", "1 分钟前"),
        ("2026-01-05T11:58:31", "1 分钟前"),
        ("2026-01-05T11:58:30", "2 分钟前"),
        ("2026-01-05T11:15:01", "大约 1 小时前"),
        ("2026-01-05T11:15:00", "大约 1 小时前"),
        ("2026-01-05T10:30:30", "大约 2 小时前"),
        ("2026-01-04T12:00:30", "1 天前"),
        ("2026-01-03T18:00:30", "2 天前"),
        ("2026-01-03T18:00:00", "2 天前"),
        ("2025-12-07T12:00:00", "29 天前"),
        ("2025-12-06T12:00:00", "大约 1 个月前"),
        ("2025-11-07T12:00:00", "大约 2 个月前"),
        ("2025-01-06T12:00:00", "12 个月前"),
        ("2024-12-01T12:00:00", "大约 1 年前"),
        ("2024-06-24T12:00:00", "超过 1 年前"),
        ("2024-02-05T12:00:00", "将近 2 年前"),
        ("2025-06-05T12:00:00", "7 个月前"),
        ("2024-02-29T12:00:00", "将近 2 年前")
    ]
    for (entry in cases) {
        @Expect(relativeTime(Some(entry[0]), RELATIVE_NOW), entry[1])
    }
}

@Test
func relativeTimeMonthEndTest(): Unit {
    // 月末回退：2/28 → 3/31 落在「大约 1 个月」档；12/31 → 1/31 同样。
    @Expect(relativeTime(Some("2026-02-28T12:00:00"), "2026-03-31T12:00:00"), "大约 1 个月前")
    @Expect(relativeTime(Some("2025-12-31T12:00:00"), "2026-01-31T12:00:00"), "大约 1 个月前")
    // 2/1 → 3/1 未满两个月，按天计。
    @Expect(relativeTime(Some("2026-02-01T12:00:00"), "2026-03-01T12:00:00"), "28 天前")
}

@Test
func relativeTimeFutureTest(): Unit {
    let cases = [
        ("2026-01-05T12:00:00", "不到 1 分钟前"),
        ("2026-01-05T12:00:29", "不到 1 分钟内"),
        ("2026-01-05T12:00:30", "1 分钟内"),
        ("2026-01-05T12:01:29", "1 分钟内"),
        ("2026-01-05T12:01:30", "2 分钟内"),
        ("2026-01-05T12:44:59", "大约 1 小时内"),
        ("2026-01-05T12:45:00", "大约 1 小时内"),
        ("2026-01-05T13:29:30", "大约 2 小时内"),
        ("2026-01-06T11:59:30", "1 天内"),
        ("2026-01-07T05:59:30", "2 天内"),
        ("2026-01-07T06:00:00", "2 天内"),
        ("2026-02-03T12:00:00", "29 天内"),
        ("2026-02-04T12:00:00", "大约 1 个月内"),
        ("2026-03-05T12:00:00", "大约 2 个月内"),
        ("2027-01-04T12:00:00", "12 个月内"),
        ("2027-02-09T12:00:00", "大约 1 年内"),
        ("2027-07-19T12:00:00", "超过 1 年内"),
        ("2027-12-06T12:00:00", "将近 2 年内")
    ]
    for (entry in cases) {
        @Expect(relativeTime(Some(entry[0]), RELATIVE_NOW), entry[1])
    }
}

@Test
func relativeTimeFallbackTest(): Unit {
    @Expect(relativeTime(None, RELATIVE_NOW), "—")
    @Expect(relativeTime(Some(""), RELATIVE_NOW), "—")
    @Expect(relativeTime(Some("oops"), RELATIVE_NOW), "—")
    @Expect(relativeTime(Some("2026-01-05T10:00:00"), "not-a-timestamp"), "—")
}
