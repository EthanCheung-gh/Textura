{
  "name": "entry",
  "version": "1.0.0",
  "description": "Textura HarmonyOS entry module",
  "dependencies": {
    // Types for the NAPI module libSDL3.so exposes; the .so itself is staged in entry/libs by
    // cangjie/scripts/harmony/stage_libs.sh.
    "libSDL3.so": "file:./src/main/cpp/types/libSDL3",
    // Types for the ArkTS -> SDL key bridge built by this module's CMakeLists.txt (TEXTURA-CUI-P05).
    "libtextura_keys.so": "file:./src/main/cpp/types/libtextura_keys",
    // Official ArkTS-facing Cangjie loader. Types live here; the .so itself is staged in
    // entry/libs/arm64-v8a by the same script.
    "libark_interop_loader.so": "file:./src/main/cangjie/loader"
  }
}
