{
  "app": {
    /*
     * Debug signing material reused from the reference project (PixCap-Cangjie/.certs/pixcapt-debug).
     * The passwords are DevEco-encrypted strings that only decrypt against this machine's
     * ~/.ohos/config, which is why they can sit in the repository; the .certs directory itself is
     * outside this repository and must exist on the build host.
     *
     * IMPORTANT: that profile is a *debug* profile pinned to bundle-name com.ethancheung.pixcapt and
     * to one device UDID, so it can sign this HAP but not authorize it for install. See
     * cangjie/docs/HARMONY.md §7.1 (signing) for the exact consequence and the next step.
     *
     * Do not hand-edit these five fields. Replace the whole material set with
     *   cangjie/scripts/harmony/set_signing_material.sh --store-file ... --key-alias ... \
     *       --cert ... --profile ...
     * which validates that the profile's bundle-name matches AppScope/app.json5 before writing.
     * assemble_hap.sh prints the profile's bundleName next to this file's bundleName on every run,
     * so a mismatch shows up before hvigor's (slow) 00303074.
     */
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "/home/ethan/CodeRepo/sandbox/PixCap-Cangjie/.certs/pixcapt-debug/PixCaptDebug.cer",
          "keyAlias": "pixcapt-debug",
          "keyPassword": "00000017B8924DDBE89BD0326A2755D67A7F9A50F1E17734FFB29B235ED322E751E09D6F63406D",
          "profile": "/home/ethan/CodeRepo/sandbox/PixCap-Cangjie/.certs/pixcapt-debug/PixCaptDebugCertDebug.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "/home/ethan/CodeRepo/sandbox/PixCap-Cangjie/.certs/pixcapt-debug/pixcapt-debug.p12",
          "storePassword": "000000178B716707D315ABD39C1B03FE9A4728BDC6974A1A114C23FA81E04D7EC440F76E792EE6"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        // The SDL HarmonyOS port requires HarmonyOS 5.0.4 / API 16 or later; the local command-line
        // SDK is API 26 and compiles against it while keeping 16 as the compatibility floor.
        "targetSdkVersion": "5.0.4(16)",
        "compatibleSdkVersion": "5.0.4(16)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      },
      {
        /*
         * Same product without a signing config.
         *
         * hvigor refuses to sign a HAP whose bundleName differs from the one inside the provisioning
         * profile (00303074). The only debug profile available on this machine belongs to
         * com.ethancheung.pixcapt, so the signed product inevitably fails *here*; this one lets
         * `assembleHap` complete and produces entry-default-unsigned.hap. Installing that artifact
         * needs a debug profile issued for com.ethancheung.textura (cangjie/docs/HARMONY.md §7).
         */
        "name": "unsigned",
        "targetSdkVersion": "5.0.4(16)",
        "compatibleSdkVersion": "5.0.4(16)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        { "name": "default", "applyToProducts": [ "default", "unsigned" ] }
      ]
    }
  ]
}
