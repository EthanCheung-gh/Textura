# Cangjie build output
target/
third_party/CUI/target/
third_party/cangjie-sdl/target/

# Generated parity artifacts
tools/parity/out/
*.bmp
*.rgba

# Device-extracted HarmonyOS system libraries (libc++.so and friends) staged for the HAP.
# These are copied out of /system/lib64 with `hdc file recv`; they must never enter the
# repository. See cangjie/docs/HARMONY.md §7.2.
harmony/device-libs/

# Signing material generated by scripts/harmony/make_csr.sh or downloaded from AGC: private keys,
# CSR, .cer/.p7b and password.txt. NEVER commit these, do not `git add -f`. See docs/HARMONY.md §7.1a.
harmony/.certs/

# HarmonyOS build artifacts produced inside cangjie/harmony
harmony/out/
harmony/entry/libs/
harmony/.hvigor/
harmony/oh_modules/
harmony/hvigor/.hvigor/
harmony/host/target/
harmony/host/crti.o
harmony/host/crtn.o

# Packaged HAP/AAB output is a build product (≈29 MB), never committed.
*.hap
*.aab

# Node / hvigor package caches
node_modules/
oh_modules/
build/default/
.hvigor/

# Cangjie local caches
.cjpm/
*.cjo.tmp

# Editor / OS noise
.DS_Store
*.swp

# Responsive-layout review screenshots (1440x900 / 1024x640), regenerated by scripts/parity.sh.
tools/parity/out-*/
